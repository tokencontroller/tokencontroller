  "db_name": "PostgreSQL",
  "query": "\n        UPDATE api_tokens t\n        SET last_used_at = now()\n        FROM people p\n        WHERE t.token_hash = $1\n          AND t.kind = $2\n          AND t.revoked_at IS NULL\n          AND p.id = t.person_id\n        RETURNING t.id, t.organization_id, p.id AS person_id, p.email,\n                  p.removed_at IS NOT NULL AS \"person_removed!\"\n        ",
