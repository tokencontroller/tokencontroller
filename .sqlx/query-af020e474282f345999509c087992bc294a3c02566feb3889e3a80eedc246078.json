  "query": "SELECT id, recorded_at, recorded_by, supersedes, payload\n         FROM events\n         WHERE organization_id = $1\n           AND (kind = 'grant'\n                OR (kind = 'reversal' AND starts_with(payload->>'reversal', $2)))\n         ORDER BY recorded_at, id",
