{
  "db_name": "PostgreSQL",
  "query": "\n        UPDATE sessions s\n        SET last_seen_at = now()\n        FROM people p\n        WHERE s.token_hash = $1\n          AND s.expires_at > now()\n          AND p.id = s.person_id\n          AND p.removed_at IS NULL\n        RETURNING p.id, p.organization_id, p.role, s.client\n        ",
