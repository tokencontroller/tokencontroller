---
// The Token Controller mark. Matches favicon.svg.
interface Props { size?: number }
const { size = 24 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 28 28" aria-hidden="true"><rect x="2" y="2" width="24" height="24" rx="6" fill="#0F3D33" /><rect x="8" y="10" width="12" height="2.6" rx="1.3" fill="#F7F5F0" /><rect x="8" y="15.4" width="12" height="2.6" rx="1.3" fill="#fff" /></svg>
